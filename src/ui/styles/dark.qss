/***************************************************************************
 * YMU DESIGN SYSTEM (Dark Theme)                                          *
 ***************************************************************************/

/* --- BASE COLORS ---
 * @background:  The darkest color, for the window itself.
 * @surface:     A layer above, for container backgrounds like the sidebar.
 * @panel:       The lightest background color, for interactive panels.
 *
 * --- ACCENT COLOR ---
 * @primary:     The main accent color (a calmer green).
 * @primary-text: Text color for elements with a @primary background.
 *
 * --- TEXT COLORS ---
 * @text-primary:   Default text color.
 * @text-secondary: For less important text.
 * @text-disabled:  Text on disabled elements.
 * --- OTHER ---
 * @border-color: Color for subtle borders.
 * @radius:       Universal corner radius.
 */

/* --- GLOBAL STYLES --- */
QWidget {
    color: #E0E0E0; /* @text-primary */
    font-family: "Rubik", "Segoe UI", "Segoe UI Arabic", "Yu Gothic UI", "Microsoft YaHei UI", "Microsoft JhengHei UI", "Malgun Gothic", "Nirmala UI", "Leelawadee UI", "Meiryo UI", "Meiryo", sans-serif;
    font-size: 16px;
}

QMainWindow {
    background-color: #121212; /* @background */
}

/* --- SIDEBAR --- */
QWidget#Sidebar {
    background-color: #1E1E1E; /* @surface */
    border-right: 1px solid #333333; /* @border-color */
}

QPushButton#SidebarButton {
    background-color: transparent;
    color: #8B8B8B; /* @text-secondary */
    border: 1px solid transparent;
    padding: 12px;
    font-size: 16px;
    text-align: left;
    border-radius: 10px; /* @radius */
    margin: 4px 8px;
    spacing: 10px;
}

QPushButton#SidebarButton:hover:!checked {
    background-color: #2C2C2C; /* @panel */
    color: #E0E0E0; /* @text-primary */
}

QPushButton#SidebarButton:checked {
    background-color: transparent;
    color: #FFFFFF;
    font-weight: 600;
    border: 1px solid transparent;
}

/* --- PRIMARY BUTTONS --- */
QPushButton {
    background-color: #28A745; /* @primary */
    color: #FFFFFF; /* @primary-text */
    border: 2px solid transparent;
    padding: 10px 18px;
    min-height: 20px;
    font-weight: 600;
    font-size: 16px;
    border-radius: 10px; /* @radius */
}

QPushButton:hover {
    background-color: #2ebf4f;
}

QPushButton:disabled {
    background-color: #333333; /* @border-color */
    color: #8B8B8B; /* @text-disabled */
}

/* --- OTHER WIDGETS --- */
QLabel {
    background-color: transparent;
}

QLabel:disabled,
QLabel[unsupported="true"] {
    color: #666666;
}

/* --- Dialog & Message Box Styling --- */
QDialog, QMessageBox {
    background-color: #1E1E1E; /* @surface */
}
QMessageBox QLabel, QDialog QLabel {
    color: #E0E0E0;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 16px;
    font-size: 14px;
}

/* --- Tooltip Styling --- */
QToolTip {
    background-color: #262626;
    color: #E0E0E0;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
}

/* --- Context Menu Styling --- */
QMenu {
    background-color: #1E1E1E;
    color: #E0E0E0;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 14px;
    border-radius: 4px;
}

QMenu::icon {
    padding-left: 6px;
    padding-right: 8px;
}

QMenu::item:selected {
    background-color: #333333;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #666666;
}

QMenu::separator {
    height: 1px;
    background-color: #333333;
    margin: 4px 6px;
}

/* Style for the '?' button */
QPushButton#InfoButton {
    background-color: transparent;
    color: #8B8B8B;
    border: 1px solid #333333;
    border-radius: 18px;
    padding: 0px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}

QPushButton#InfoButton:hover {
    background-color: #333333;
    border-color: #555555;
    color: #E0E0E0;
}

/* Styling for the tabs inside the dialog */
QDialog#AboutDialog,
QDialog#InfoDialog,
QDialog#LicenseViewerDialog {
    background-color: #1E1E1E;
}

QDialog#LicenseViewerDialog QTextBrowser,
QDialog#LicenseViewerDialog QTextBrowser#LicenseTextBrowser,
QTextBrowser#LicenseTextBrowser,
QDialog#LicenseViewerDialog QPlainTextEdit {
    background-color: #242424;
    color: #E0E0E0;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 12px;
    selection-background-color: #28A745;
    selection-color: #FFFFFF;
}

QDialog#LicenseViewerDialog QTextBrowser QScrollBar:vertical,
QTextBrowser#LicenseTextBrowser QScrollBar:vertical {
    background: #242424;
    width: 8px;
}

QDialog#LicenseViewerDialog QTextBrowser QScrollBar::handle:vertical,
QTextBrowser#LicenseTextBrowser QScrollBar::handle:vertical {
    background: #444444;
    border-radius: 4px;
    min-height: 24px;
}

QDialog#LicenseViewerDialog QTextBrowser QScrollBar::handle:vertical:hover,
QTextBrowser#LicenseTextBrowser QScrollBar::handle:vertical:hover {
    background: #555555;
}

QDialog#LicenseViewerDialog QTextBrowser a,
QTextBrowser#LicenseTextBrowser a {
    color: #28A745;
    text-decoration: none;
}

QDialog#InfoDialog QTabBar::tab,
QDialog#AboutDialog QTabBar::tab {
    qproperty-alignment: 'AlignCenter';
    background-color: transparent;
    color: #8B8B8B;
    padding: 8px 16px;
    border: 1px solid transparent;
    border-bottom: 2px solid transparent;
    border-radius: 4px;
}

QDialog#InfoDialog QTabBar::tab:hover,
QDialog#AboutDialog QTabBar::tab:hover {
    qproperty-alignment: 'AlignCenter';
    color: #E0E0E0;
}

QDialog#InfoDialog QTabBar::tab:selected,
QDialog#AboutDialog QTabBar::tab:selected {
    qproperty-alignment: 'AlignCenter';
    color: #FFFFFF;
    font-weight: 600;
    border-bottom: 2px solid #28A745; /* @primary */
}

QDialog#InfoDialog QTabBar::tab:focus,
QDialog#AboutDialog QTabBar::tab:focus {
    color: #FFFFFF;
    border: 1px solid #28A745;
    border-bottom: 2px solid #28A745;
    border-radius: 4px;
    background-color: rgba(40, 167, 69, 0.15);
}

/* The tab bar's own background (not the tabs) — match the dialog surface. */
QDialog#InfoDialog QTabBar,
QDialog#AboutDialog QTabBar { background-color: #1E1E1E; }

QDialog#InfoDialog QStackedWidget,
QDialog#AboutDialog QStackedWidget {
    background-color: #2C2C2C; /* @panel */
    border: 1px solid #333333;   /* @border-color */
    border-radius: 6px;         /* @radius */
}

/* --- Styled Frame (Card) --- */
QFrame#CardFrame {
    background-color: #1E1E1E; /* @surface */
    border: 1px solid #333333; /* @border-color */
    border-radius: 14px; /* @radius */
    padding: 14px;
}

/* --- LineEdit Styling --- */
QLineEdit {
    background-color: #262626;
    color: #E0E0E0;
    border: 1px solid #333333;
    border-radius: 10px;
    padding: 10px 14px;
    min-height: 22px;
    font-size: 14px;
    selection-background-color: #28A745;
    selection-color: #FFFFFF;
}

QLineEdit:hover {
    border-color: #555555;
}

/* --- ComboBox Styling --- */
QComboBox {
    background-color: #2C2C2C; /* @panel */
    border: 1px solid #333333;
    border-radius: 10px;
    padding: 10px 14px;
    min-height: 22px;
    color: #E0E0E0;
}

QComboBox:hover {
    border-color: #555555;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: url({ASSET_PATH}/chevron-down.svg);
    width: 20px;
    height: 20px;
    padding-right: 10px;
}

/* Dropdown popup panel: slightly darker than the trigger for contrast. */
QComboBox QAbstractItemView {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 2px;
    outline: 0px;
    color: #E0E0E0;
}

/* Slim popup rows. */
QComboBox QAbstractItemView::item {
    padding: 2px 8px;
    border-radius: 4px;
    min-height: 18px;
    margin: 0px;
}

/* Selected/hover: neutral grey, not the green accent. */
QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #333333;
    color: #FFFFFF;
}

QLabel#SettingsTitle {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 10px;
}

/* --- Theme-Buttons --- */
QPushButton#ThemeButton {
    background-color: #333333;
    color: #8B8B8B;
    border: 1px solid #555555;
    padding: 10px 18px;
    min-height: 22px;
    border-radius: 10px;
}

QPushButton#ThemeButton:hover {
    background-color: #444444;
    color:#CCCCCC;
}

QPushButton#ThemeButton:checked {
    background-color: #E0E0E0;
    color: #121212;
    border-color: #E0E0E0;
}

/* --- Link-Buttons --- */
QPushButton#LinkButton {
    background-color: transparent;
    color: #8B8B8B; /* @text-secondary */
    border: 1px solid #333333; /* @border-color */
    border-radius: 10px;
    text-align: left;
    padding: 10px 14px;
    min-height: 22px;
    spacing: 8px;
}

QPushButton#LinkButton:hover {
    background-color: #333333;
    color: #E0E0E0; /* @text-primary */
    text-decoration: none;
}

/* --- ScrollBar Styling --- */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    border: none;
    background: #2C2C2C;
    width: 10px;
    margin: 0;
}

/* The handle that you drag */
QScrollBar::handle:vertical {
    background: #555555;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #6E6E6E;
}

/* The track above and below the handle */
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* The top and bottom arrow buttons (hidden) */
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    border: none;
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #2C2C2C;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #555555;
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #6E6E6E;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    border: none;
    width: 0px;
}

QScrollBar::corner {
    background: transparent;
}

QWidget#ScrollContainer {
    background-color: #121212; /* @background */
}

QLabel#DisabledListHeader {
    color: #e84555;
    font-size: 14px;
    font-weight: 600;
}

QLabel#EnabledListHeader {
    color: #28A745;
    font-size: 14px;
    font-weight: 600;
}

/* --- Lua Header Action Buttons --- */
QPushButton#LuaHeaderAction {
    background-color: transparent;
    color: #8B8B8B;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 0px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#LuaHeaderAction:hover {
    background-color: #2C2C2C;
    border-color: #555555;
    color: #E0E0E0;
}

QPushButton#LuaHeaderAction:disabled {
    color: #555555;
    border-color: transparent;
}

/* --- Lua Refresh Toolbar Button --- */
QPushButton#RefreshButton {
    padding: 0px;
    border: 1px solid #333333;
    background-color: transparent;
    border-radius: 10px;
}

QPushButton#RefreshButton:hover {
    background-color: #333333;
    border-color: #555555;
}

QFrame#CardFrame QListWidget {
    font-family: Consolas, monospace;
    font-size: 14px;
    background-color: #262626;
    border-radius: 8px;
    border: 1px solid #333333;
    padding: 2px;
}

QFrame#CardFrame QListWidget::item {
    border-radius: 6px;
    padding: 0px;
    margin: 1px 0px;
}

QFrame#CardFrame QListWidget::item:hover {
    background-color: #333333;
}

QFrame#CardFrame QListWidget::item:selected {
    background-color: #383838;
}

QLabel#LuaScriptLabel {
    font-family: Consolas, monospace;
    font-size: 14px;
    color: #E0E0E0;
}

QPushButton#LuaItemActionButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
    margin: 0px;
    font-size: 12px;
}

QPushButton#LuaItemActionButton:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

/* --- Sidebar Footer --- */
QPushButton#SidebarFooter {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #666666;
    font-size: 12px;
    text-align: center;
    padding: 10px;
}

QPushButton#SidebarFooter:hover {
    color: #8B8B8B; /* @text-secondary */
}

/* --- Risk Page Styles --- */
QLabel#RiskTitleLabel {
    color: #e84555;
    font-size: 18px;
    font-weight: 600;
    qproperty-alignment: 'AlignCenter';
}

QLabel#RiskInfoLabel {
    qproperty-alignment: 'AlignCenter';
    font-size: 14px;
}

/* --- KEYBOARD FOCUS STYLES --- */
*:focus {
    outline: none;
}

QPushButton:focus {
    border: 2px solid #FFFFFF;
}

QPushButton#SidebarButton:focus {
    border: 1px solid #28A745;
}

QPushButton#SidebarFooter:focus {
    border: 1px solid #28A745;
    color: #E0E0E0;
}

QPushButton#InfoButton:focus {
    border: 1px solid #28A745;
    color: #E0E0E0;
}

QPushButton#ThemeButton:focus {
    border: 1px solid #28A745;
}

QPushButton#ThemeButton:checked:focus {
    border: 1px solid #28A745;
    background-color: #E0E0E0;
    color: #121212;
}

QPushButton#LinkButton:focus {
    border: 1px solid #28A745;
    background-color: #2C2C2C;
    color: #E0E0E0;
}

QDialog#LicenseViewerDialog QTextBrowser:focus,
QDialog#LicenseViewerDialog QTextBrowser#LicenseTextBrowser:focus,
QTextBrowser#LicenseTextBrowser:focus,
QDialog#LicenseViewerDialog QPlainTextEdit:focus {
    border: 1px solid #28A745;
}

QComboBox:focus,
QLineEdit:focus,
QListWidget:focus,
QFrame#CardFrame QListWidget:focus {
    border: 1px solid #28A745;
}

/* Lua Manager Buttons */
QPushButton#LuaHeaderAction:focus {
    border: 1px solid #28A745;
    color: #E0E0E0;
    background-color: #2C2C2C;
}

QPushButton#LuaItemActionButton:focus {
    border: 1px solid #28A745;
    background-color: rgba(255, 255, 255, 0.12);
}

QPushButton#RefreshButton:focus {
    border: 1px solid #28A745;
}

/* --- Notification System --- */
QFrame#NotificationCard {
    background-color: #1E1E1E; /* @surface */
    border: 1px solid #333333; /* @border-color */
    border-radius: 14px; /* @radius */
}

#NotificationCard QLabel#NotificationTitle {
    font-size: 16px;
    font-weight: 600;
    color: #E0E0E0; /* @text-primary */
}

#NotificationCard QLabel#NotificationMessage {
    font-size: 14px;
    color: #8B8B8B; /* @text-secondary */
}

#NotificationCard QPushButton#NotificationCloseButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 0px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
}

#NotificationCard QPushButton#NotificationCloseButton:hover {
    background-color: #333333;
}

#NotificationCard QPushButton#NotificationCloseButton:focus {
    border-color: #28A745;
}

#NotificationCard QPushButton#NotificationActionButton {
    background-color: #333333;
    color: #FFFFFF;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
}

#NotificationCard QPushButton#NotificationActionButton:hover {
    background-color: #28A745;
    border-color: #28A745;
    color: #FFFFFF;
}

#NotificationCard QPushButton#NotificationActionButton:focus {
    border: 1px solid #28A745;
}
