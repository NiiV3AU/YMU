/***************************************************************************
 * YMU DESIGN SYSTEM (Light Theme)                                         *
 *
 * Elevation scale (mirrors the dark theme's logic, correctly inverted):
 *   @background #F2F3F5  the page / recessed base
 *   @surface    #FFFFFF  elevated white for sidebar, cards, dialogs
 *   @panel      #ECEEF1  interactive fills (inputs, hovers)
 *   @panel-2    #E2E5EA  stronger fill (checked / hover-2)
 *   @border     #E3E6EA  single subtle border token
 *   @border-2   #C4C9D0  hover / focus border
 * Text: primary #1A1D21, secondary #5B6169, muted #A6ACB4.
 * Cards get real elevation from a soft drop shadow applied in code
 * (MainWindow._apply_card_shadows), since Qt QSS has no box-shadow.
 ***************************************************************************/

/* --- GLOBAL STYLES --- */
QWidget {
    color: #1A1D21;
    font-family: "Rubik", "Segoe UI", "Segoe UI Arabic", "Yu Gothic UI", "Microsoft YaHei UI", "Microsoft JhengHei UI", "Malgun Gothic", "Nirmala UI", "Leelawadee UI", "Meiryo UI", "Meiryo", sans-serif;
    font-size: 16px;
}

QMainWindow {
    background-color: #F2F3F5;
}

/* --- SIDEBAR --- */
QWidget#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E3E6EA;
}

QPushButton#SidebarButton {
    background-color: transparent;
    color: #5B6169;
    border: 1px solid transparent;
    padding: 12px;
    font-size: 16px;
    text-align: left;
    border-radius: 10px;
    margin: 4px 8px;
    spacing: 10px;
}

QPushButton#SidebarButton:hover:!checked {
    background-color: #ECEEF1;
    color: #1A1D21;
}

QPushButton#SidebarButton:checked {
    background-color: transparent;
    color: #1A1D21;
    font-weight: 600;
    border: 1px solid transparent;
}

/* --- PRIMARY BUTTONS --- */
QPushButton {
    background-color: #28A745;
    color: #FFFFFF;
    border: 2px solid transparent;
    padding: 10px 18px;
    min-height: 20px;
    font-weight: 600;
    font-size: 16px;
    border-radius: 10px;
}

QPushButton:hover {
    background-color: #2ebf4f;
}

QPushButton:disabled {
    background-color: #ECEEF1;
    color: #A6ACB4;
}

QLabel {
    background-color: transparent;
}

QLabel:disabled,
QLabel[unsupported="true"] {
    color: #A6ACB4;
}

/* --- Dialog & Message Box Styling --- */
QDialog, QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel, QDialog QLabel {
    color: #1A1D21;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 16px;
    font-size: 14px;
}

/* --- Tooltip Styling --- */
QToolTip {
    background-color: #FFFFFF;
    color: #1A1D21;
    border: 1px solid #CED4DA;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
}

/* --- Context Menu Styling --- */
QMenu {
    background-color: #FFFFFF;
    color: #1A1D21;
    border: 1px solid #CED4DA;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 14px;
    border-radius: 4px;
}

QMenu::icon {
    padding-left: 6px;
    padding-right: 8px;
}

QMenu::item:selected {
    background-color: #ECEEF1;
    color: #1A1D21;
}

QMenu::item:disabled {
    color: #A6ACB4;
}

QMenu::separator {
    height: 1px;
    background-color: #E3E6EA;
    margin: 4px 6px;
}

QPushButton#InfoButton {
    background-color: transparent;
    color: #5B6169;
    border: 1px solid #E3E6EA;
    border-radius: 18px;
    padding: 0px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}

QPushButton#InfoButton:hover {
    background-color: #ECEEF1;
    border-color: #C4C9D0;
    color: #1A1D21;
}

QDialog#AboutDialog,
QDialog#InfoDialog,
QDialog#LicenseViewerDialog {
    background-color: #FFFFFF;
}

QDialog#LicenseViewerDialog QTextBrowser,
QDialog#LicenseViewerDialog QTextBrowser#LicenseTextBrowser,
QTextBrowser#LicenseTextBrowser,
QDialog#LicenseViewerDialog QPlainTextEdit {
    background-color: #F8F9FA;
    color: #1A1D21;
    border: 1px solid #E3E6EA;
    border-radius: 8px;
    padding: 12px;
    selection-background-color: #218838;
    selection-color: #FFFFFF;
}

QDialog#LicenseViewerDialog QTextBrowser QScrollBar:vertical,
QTextBrowser#LicenseTextBrowser QScrollBar:vertical {
    background: #F8F9FA;
    width: 8px;
}

QDialog#LicenseViewerDialog QTextBrowser QScrollBar::handle:vertical,
QTextBrowser#LicenseTextBrowser QScrollBar::handle:vertical {
    background: #D0D4DC;
    border-radius: 4px;
    min-height: 24px;
}

QDialog#LicenseViewerDialog QTextBrowser QScrollBar::handle:vertical:hover,
QTextBrowser#LicenseTextBrowser QScrollBar::handle:vertical:hover {
    background: #B0B6C0;
}

QDialog#LicenseViewerDialog QTextBrowser a,
QTextBrowser#LicenseTextBrowser a {
    color: #1A7F37;
    text-decoration: none;
}

QDialog#InfoDialog QTabBar::tab,
QDialog#AboutDialog QTabBar::tab {
    qproperty-alignment: 'AlignCenter';
    color: #5B6169;
    background-color: transparent;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
}

QDialog#InfoDialog QTabBar::tab:hover,
QDialog#AboutDialog QTabBar::tab:hover {
    qproperty-alignment: 'AlignCenter';
    color: #1A1D21;
}

QDialog#InfoDialog QTabBar::tab:selected,
QDialog#AboutDialog QTabBar::tab:selected {
    qproperty-alignment: 'AlignCenter';
    color: #1A1D21;
    font-weight: 600;
    border-bottom: 2px solid #28A745;
}

QDialog#InfoDialog QTabBar,
QDialog#AboutDialog QTabBar {
    background-color: #FFFFFF;
}

QDialog#InfoDialog QStackedWidget,
QDialog#AboutDialog QStackedWidget {
    background-color: #F2F3F5;
    border: 1px solid #E3E6EA;
    border-radius: 6px;
}

/* --- CONTAINERS & CARDS --- */
QFrame#CardFrame {
    background-color: #FFFFFF;
    border: 1px solid #E3E6EA;
    border-radius: 14px;
    padding: 14px;
}

QWidget#ScrollContainer {
    background-color: #F2F3F5;
}

/* --- LineEdit Styling --- */
QLineEdit {
    background-color: #F8F9FA;
    color: #1A1D21;
    border: 1px solid #E3E6EA;
    border-radius: 10px;
    padding: 10px 14px;
    min-height: 22px;
    font-size: 14px;
    selection-background-color: #218838;
    selection-color: #FFFFFF;
}

QLineEdit:hover {
    border-color: #C4C9D0;
}

/* --- ComboBox Styling --- */
QComboBox {
    background-color: #ECEEF1;
    border: 1px solid #E3E6EA;
    border-radius: 10px;
    padding: 10px 14px;
    min-height: 22px;
    color: #1A1D21;
}

QComboBox:hover {
    border-color: #C4C9D0;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: url({ASSET_PATH}/chevron-down.svg);
    width: 20px;
    height: 20px;
    padding-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E3E6EA;
    border-radius: 6px;
    padding: 2px;
    outline: 0px;
    color: #1A1D21;
}

QComboBox QAbstractItemView::item {
    padding: 2px 8px;
    border-radius: 4px;
    min-height: 18px;
    margin: 0px;
}

/* Selected/hover: light grey, not the green accent. */
QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #ECEEF1;
    color: #1A1D21;
}

/* --- TEXT & TITLES --- */
QLabel#SettingsTitle {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 10px;
}

QLabel#DisabledListHeader {
    color: #e84555;
    font-size: 14px;
    font-weight: 600;
}

QLabel#EnabledListHeader {
    color: #28A745;
    font-size: 14px;
    font-weight: 600;
}

/* --- THEME & LINK BUTTONS --- */
QPushButton#ThemeButton {
    background-color: #ECEEF1;
    color: #5B6169;
    border: 1px solid #E3E6EA;
    padding: 10px 18px;
    min-height: 22px;
    border-radius: 10px;
}

QPushButton#ThemeButton:hover {
    background-color: #E2E5EA;
    color: #1A1D21;
}

QPushButton#ThemeButton:checked {
    background-color: #1A1D21;
    color: #FFFFFF;
    border-color: #1A1D21;
}

QPushButton#LinkButton {
    background-color: transparent;
    color: #5B6169;
    border: 1px solid #E3E6EA;
    border-radius: 10px;
    text-align: left;
    padding: 10px 14px;
    min-height: 22px;
    spacing: 8px;
}

QPushButton#LinkButton:hover {
    background-color: #ECEEF1;
    color: #1A1D21;
    text-decoration: none;
}

/* --- SCROLLBAR --- */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    border: none;
    background: #F2F3F5;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #C4C9D0;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #AEB4BC;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    border: none;
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #F2F3F5;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #C4C9D0;
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #AEB4BC;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    border: none;
    width: 0px;
}

QScrollBar::corner {
    background: transparent;
}

/* --- LUA MANAGER --- */
QPushButton#LuaHeaderAction {
    background-color: transparent;
    color: #5B6169;
    border: 1px solid #E3E6EA;
    border-radius: 6px;
    padding: 0px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#LuaHeaderAction:hover {
    background-color: #ECEEF1;
    border-color: #C4C9D0;
    color: #1A1D21;
}

QPushButton#LuaHeaderAction:disabled {
    color: #A6ACB4;
    border-color: transparent;
}

QPushButton#RefreshButton {
    padding: 0px;
    border: 1px solid #E3E6EA;
    background-color: transparent;
    border-radius: 10px;
}

QPushButton#RefreshButton:hover {
    background-color: #ECEEF1;
    border-color: #C4C9D0;
}

QFrame#CardFrame QListWidget {
    font-family: Consolas, monospace;
    font-size: 14px;
    background-color: #F8F9FA;
    border-radius: 8px;
    border: 1px solid #E3E6EA;
    padding: 2px;
}

QFrame#CardFrame QListWidget::item {
    border-radius: 6px;
    padding: 0px;
    margin: 1px 0px;
}

QFrame#CardFrame QListWidget::item:hover {
    background-color: #ECEEF1;
}

QFrame#CardFrame QListWidget::item:selected {
    background-color: #E2E5EA;
}

QLabel#LuaScriptLabel {
    font-family: Consolas, monospace;
    font-size: 14px;
    color: #121212;
}

QPushButton#LuaItemActionButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
    margin: 0px;
    font-size: 12px;
}

QPushButton#LuaItemActionButton:hover {
    background-color: rgba(0, 0, 0, 0.08);
}

/* --- FOOTER --- */
QPushButton#SidebarFooter {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #A6ACB4;
    font-size: 12px;
    text-align: center;
    padding: 10px;
}

QPushButton#SidebarFooter:hover {
    color: #5B6169;
}

/* --- Risk Page Styles --- */
QLabel#RiskTitleLabel {
    color: #e84555;
    font-size: 18px;
    font-weight: 600;
    qproperty-alignment: 'AlignCenter';
}

QLabel#RiskInfoLabel {
    qproperty-alignment: 'AlignCenter';
    font-size: 14px;
}

/* --- KEYBOARD FOCUS STYLES --- */
*:focus {
    outline: none;
}

QPushButton:focus {
    border: 2px solid #1A1D21;
}

QPushButton#SidebarButton:focus {
    border: 1px solid #218838;
}

QPushButton#SidebarFooter:focus {
    border: 1px solid #218838;
    color: #1A1D21;
}

QPushButton#InfoButton:focus {
    border: 1px solid #218838;
    color: #1A1D21;
}

QPushButton#ThemeButton:focus {
    border: 1px solid #218838;
}

QPushButton#ThemeButton:checked:focus {
    border: 1px solid #218838;
    background-color: #1A1D21;
    color: #FFFFFF;
}

QPushButton#LinkButton:focus {
    border: 1px solid #218838;
    color: #1A1D21;
}

QComboBox:focus,
QLineEdit:focus,
QListWidget:focus,
QFrame#CardFrame QListWidget:focus {
    border: 1px solid #218838;
}

/* Lua Manager Buttons */
QPushButton#LuaHeaderAction:focus {
    border: 1px solid #218838;
    color: #1A1D21;
    background-color: #ECEEF1;
}

QPushButton#LuaItemActionButton:focus {
    border: 1px solid #218838;
    background-color: rgba(0, 0, 0, 0.08);
}

QPushButton#RefreshButton:focus {
    border: 1px solid #218838;
}

/* --- Notification System --- */
QFrame#NotificationCard {
    background-color: #FFFFFF;
    border: 1px solid #E3E6EA;
    border-radius: 14px;
}

#NotificationCard QLabel#NotificationTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1A1D21;
}

#NotificationCard QLabel#NotificationMessage {
    font-size: 14px;
    color: #5B6169;
}

#NotificationCard QPushButton#NotificationCloseButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 0px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
}

#NotificationCard QPushButton#NotificationCloseButton:hover {
    background-color: #ECEEF1;
}

#NotificationCard QPushButton#NotificationCloseButton:focus {
    border-color: #218838;
}

#NotificationCard QPushButton#NotificationActionButton {
    background-color: #E9ECEF;
    color: #1A1D21;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
}

#NotificationCard QPushButton#NotificationActionButton:hover {
    background-color: #218838;
    border-color: #218838;
    color: #FFFFFF;
}

#NotificationCard QPushButton#NotificationActionButton:focus {
    border: 1px solid #218838;
}
